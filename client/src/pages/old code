{/* USER DROPDOWN */}
        <Typography variant="h6" fontWeight="bold" mb={1}>
            Select User
        </Typography>

        <Box sx={{ display: "flex", gap: 2 }}>

            {/* Reported user */}
                <TextField
                    sx={{ width: "50%" }}
                    required
                    select
                    label="Reported User"
                    name="reportedUser"
                    value={selectedUser}
                    onChange={async (e) => {
                        setSelectedUser(e.target.value);
                        await fetchReports(e.target.value);
                    }}
                >
                    {userList.map((reason) => (
                        <MenuItem key={reason.email} value={reason.email}>
                            {reason.email}
                        </MenuItem>
                    ))}
                </TextField>
            {/* User report */}
            <TextField
                sx={{ width: "50%" }}
                fullWidth
                required
                select
                label="User Reports"
                name="reports"
                value={selectedReport}
                onChange={async (e) => {
                    setSelectedReport(e.target.value);

                    if (e.target.value != "") {
                        var pro = reportList.find(
                            item => item._id === e.target.value
                        ).product;

                        if (pro == "") {
                            setSelectedProduct({});
                        } else {
                            var data = await products.getProduct(pro);
                            setSelectedProduct(data);
                        }
                    }
                }}
                disabled={isDisabled}
            >
                {reportList.map((rep) => (
                    <MenuItem key={rep._id} value={rep._id}>
                        {rep._id}
                    </MenuItem>
                ))}
            </TextField>
        </Box>

        <Divider sx={{ mb: 2 }} />
        {/* REPORT REASON */}

        {selectedReport && (
            <Paper
                elevation={4}
                sx={{
                    maxWidth: "2000px",
                    width: "100%",
                    p: 1,
                    boxShadow: 3,
                    maxheight: "100px",
                    height: "75%",
                }}
            >
                <Typography variant="h6" fontWeight="bold" mb={1}>
                    {"Report Reason: " +
                        reportList.find(item => item._id === selectedReport).reason}
                </Typography>

                <Typography variant="h6" fontWeight="bold" mb={1}>
                    {"Comments: " +
                        reportList.find(item => item._id === selectedReport).comment}
                </Typography>
            </Paper>
        )}

        {/* SELECTED USER AND PRODUCT CARDS */}
        <Box sx={{ display: "flex", gap: 2 }}>
            {user.userType && (
                <Card sx={{ overflow: "hidden" , flex: 1 }}>
                    <Typography variant="h6" fontWeight="bold" mb={1}>
                        {user.userType == "business"
                            ? user.businessName
                            : user.firstName + " " + user.lastName}
                    </Typography>

                    <Box
                        component="img"
                        src={user.profileImage}
                        alt={"Profile Picture"}
                        loading="lazy"
                        sx={{
                            display: "block",
                            width: "100%",
                            height: 260, //ajust the height as needed
                            objectFit: "cover",
                            bgcolor: "grey.100",
                        }}
                    />

                    <Button
                        color="error"
                        variant="contained"
                        onClick={handleBan}
                    >
                        Ban User
                    </Button>
                </Card>
            )}

            {/* PRODUCT CARD */}
            {selectedProduct.imageUrl && (
                <Card sx={{ overflow: "hidden" , flex: 1 }}>
                    {typeof selectedProduct.imageUrl === "string" &&
                        selectedProduct.imageUrl && (
                            <Box
                                component="img"
                                src={selectedProduct.imageUrl}
                                alt={selectedProduct.title}
                                loading="lazy"
                                sx={{
                                    display: "block",
                                    width: "100%",
                                    height: 260, //ajust the height as needed
                                    objectFit: "cover",
                                    bgcolor: "grey.100",
                                }}
                            />
                        )}

                    {/* THE STACK */}
                    <CardContent sx={{ p: 2 }}>
                        <Stack
                            direction="column"
                            justifyContent="space-between"
                            alignItems="center"
                            spacing={1}
                        >
                            <Typography
                                component="h3"
                                variant="subtitle1"
                                sx={{
                                    color: "#3d0f3e",
                                    lineHeight: 1.3,
                                    mt: 1.5,
                                    display: "-webkit-box",
                                    WebkitBoxOrient: "vertical",
                                    WebkitLineClamp: 2,
                                    overflow: "hidden",
                                    textOverflow: "ellipsis",
                                }}
                            >
                                {selectedProduct.title}
                            </Typography>

                            {(selectedProduct.categoryName ||
                                selectedProduct.condition ||
                                selectedProduct.listingType) && (
                                    <Typography
                                        variant="body1"
                                        color="text.secondary"
                                        sx={{ mt: 1 }}
                                    >
                                        {[
                                            selectedProduct.categoryName,
                                            selectedProduct.condition,
                                            selectedProduct.listingType === "peer-to-peer"
                                                ? "Pick up from seller"
                                                : "Shipping to buyer",
                                        ]
                                            .filter(Boolean)
                                            .join(" · ")}
                                    </Typography>
                                )}

                            {selectedProduct.price !== undefined && (
                                <Typography
                                    sx={{
                                        fontWeight: 700,
                                        whiteSpace: "nowrap",
                                        justifyContent: "center",
                                    }}
                                >
                                    {formatPrice(selectedProduct.price)}
                                </Typography>
                            )}
                        </Stack>
                    </CardContent>
                </Card>
            )}
        </Box>